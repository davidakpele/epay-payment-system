# Build output — rebuilt inside Docker, never needed as input
.next/
out/

# Dependencies — reinstalled inside Docker
node_modules/

# Dev/test artifacts
coverage/
.nyc_output/
e2e/
__tests__/
playwright-report/
test-results/

# Local env files (never leak secrets into the image)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production.local

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Git
.git/
.gitignore

# Docs
README.md
*.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
